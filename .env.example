# Popcorn CMS API configuration
# Get your API key from: Popcorn CMS → Settings → API Keys

VITE_API_URL=https://api.popcorncms.com/v1/public
VITE_API_KEY=your-api-key-here

# Which site to render. Published sites receive this from the site shell, so it
# is only needed for local development. Required when your tenant has more than
# one site, because page slugs are unique per site rather than per tenant.
VITE_SITE_ID=

# Google Maps (optional — required for map display on enhanced collections with geopoint fields)
VITE_GOOGLE_MAPS_API_KEY=

# Note: the API allows browser requests from localhost ports 3000-3099, so run
# the dev server in that range (e.g. `npm run dev -- --port 3099`).
